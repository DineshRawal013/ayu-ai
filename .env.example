# Copy to .env and change the password:  cp .env.example .env
POSTGRES_USER=ayu
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=ayu

# Ollama model used for the AI insight
OLLAMA_MODEL=qwen2.5:1.5b

# Public port for the website (80 on Azure; use 8080 locally if 80 is busy)
HTTP_PORT=80

# Where docker compose pulls images from on the Azure VM (lowercase GitHub username)
GHCR_OWNER=dineshrawal013
TAG=latest

# AZURE ONLY (optional): HTTPS via Caddy with a free Let's Encrypt certificate.
# DOMAIN must point at the VM (e.g. the Azure DNS name label), and port 443 must be open.
# DOMAIN=ayu-ai.koreacentral.cloudapp.azure.com
# COMPOSE_PROFILES=https
# HTTP_PORT=127.0.0.1:8080

# LOCAL ONLY (optional): Windows PostgreSQL, see docker-compose.override.example.yml
# LOCAL_PG_USER=ayu
# LOCAL_PG_PASSWORD=change-me
# LOCAL_PG_DB=ayu
# LOCAL_PG_PORT=5432
